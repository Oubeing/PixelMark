  <widget class="QDockWidget" name="measureDock">
   <property name="features">
    <set>QDockWidget::DockWidgetClosable|QDockWidget::DockWidgetMovable</set>
   </property>
   <property name="allowedAreas">
    <set>Qt::RightDockWidgetArea|Qt::LeftDockWidgetArea</set>
   </property>
   <property name="windowTitle">
    <string>测量标注列表</string>
   </property>
   <attribute name="dockWidgetArea">
    <number>2</number>
   </attribute>
   <widget class="QWidget" name="dockContents">
    <layout class="QVBoxLayout" name="vbox_dock">
     <item>
      <widget class="QListWidget" name="measureList">
       <property name="toolTip">
        <string>单击选中，双击定位到画布；Delete 删除所选</string>
       </property>
      </widget>
     </item>
     <item>
      <layout class="QHBoxLayout" name="hbox_dock">
       <item>
        <widget class="QPushButton" name="deleteMeasureBtn">
         <property name="toolTip">
          <string>删除选中的测量标注</string>
         </property>
         <property name="text">
          <string>删除所选</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="exportMeasureBtn">
         <property name="toolTip">
          <string>导出全部测量数据为 CSV</string>
         </property>
         <property name="text">
          <string>导出 CSV</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>
     <item>
      <layout class="QHBoxLayout" name="hbox_dock2">
       <item>
        <widget class="QPushButton" name="locateMeasureBtn">
         <property name="toolTip">
          <string>在画布上高亮并滚动到所选测量</string>
         </property>
         <property name="text">
          <string>定位所选</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="clearAllMeasureBtn">
         <property name="toolTip">
          <string>清除画布上全部测量与标注（可撤销）</string>
         </property>
         <property name="text">
          <string>清除全部标注</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>
    </layout>
   </widget>
