      <property name="styleSheet">
       <string notr="true">#toolPanel { background:#FFFFFF; }
#toolPanel QToolButton { font-size:11px; color:#2A2E37; padding:0px;
  border:1px solid transparent; border-radius:4px; }
#toolPanel QToolButton:hover { background:#EDF1F7; border-color:#D5DCE8; }
#toolPanel QToolButton:checked { background:#DCE9FC; color:#0B57D0;
  border:1px solid #4A86E8; }
#toolPanel QLabel { color:#444; }
#toolPanel QPushButton { border:1px solid #C4CAD4; border-radius:4px;
  padding:3px 10px; background:#FFFFFF; color:#2A2E37; }
#toolPanel QPushButton:hover { background:#F0F4FA; border-color:#4A86E8;
  color:#0B57D0; }
#toolPanel QPushButton:pressed { background:#E2EAF6; }
#toolPanel QComboBox { border:1px solid #C4CAD4; border-radius:3px;
  padding:1px 4px; background:#FFFFFF; }
#toolPanel QCheckBox { color:#2A2E37; }
#sectionDraw, #sectionMeasure { font-weight:bold; color:#2E3440;
  font-size:11px; background:#F2F4F8; border-radius:3px; padding:2px 4px; }</string>
